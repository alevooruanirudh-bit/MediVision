{
  "task": "binary",
  "label_name": "Suspicious for breast cancer",
  "dataset": "mini_ddsm",
  "model": {
    "arch": "classifier",
    "backbone": "efficientnet_b0",
    "dropout": 0.4,
    "hidden": 128
  },
  "loss": {
    "type": "weighted_bce"
  },
  "optim": {
    "lr": 0.0003,
    "weight_decay": 0.001
  },
  "augment": {
    "scale": [
      0.85,
      1.0
    ],
    "rotate": 8,
    "brightness": 0.15,
    "contrast": 0.2,
    "clahe_p": 0.3,
    "hflip": true
  },
  "train": {
    "patience": 5,
    "warmup_epochs": 1,
    "num_workers": 0,
    "monitor": "val_auroc",
    "epochs": 12,
    "batch_size": 32
  },
  "img_size": 256,
  "name": "mammo_cls",
  "profile": "starter"
}