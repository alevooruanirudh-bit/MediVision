{
  "task": "multiclass",
  "dataset": "brain_mri",
  "labels": "brain4",
  "model": {
    "arch": "classifier",
    "backbone": "efficientnet_b0",
    "dropout": 0.3,
    "hidden": 256
  },
  "loss": {
    "type": "ce",
    "label_smoothing": 0.05
  },
  "optim": {
    "lr": 0.0005,
    "weight_decay": 0.0001
  },
  "augment": {
    "scale": [
      0.8,
      1.0
    ],
    "rotate": 12,
    "brightness": 0.15,
    "contrast": 0.15,
    "clahe_p": 0.2,
    "hflip": true
  },
  "train": {
    "patience": 4,
    "warmup_epochs": 1,
    "num_workers": 0,
    "monitor": "val_macro_f1",
    "epochs": 6,
    "batch_size": 48
  },
  "img_size": 128,
  "name": "brain_cls",
  "profile": "starter"
}