{
  "task": "binary",
  "label_name": "Hemorrhage",
  "dataset": "head_ct",
  "model": {
    "arch": "classifier",
    "backbone": "efficientnet_b0",
    "dropout": 0.4,
    "hidden": 128
  },
  "loss": {
    "type": "weighted_bce"
  },
  "optim": {
    "lr": 0.0003,
    "weight_decay": 0.001
  },
  "augment": {
    "scale": [
      0.75,
      1.0
    ],
    "rotate": 15,
    "brightness": 0.15,
    "contrast": 0.2,
    "clahe_p": 0.2,
    "hflip": true
  },
  "train": {
    "patience": 6,
    "warmup_epochs": 1,
    "num_workers": 0,
    "monitor": "val_auroc",
    "epochs": 20,
    "batch_size": 16
  },
  "img_size": 192,
  "name": "head_ct_cls",
  "profile": "starter"
}