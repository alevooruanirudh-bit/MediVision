.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
.env

# data (downloaded, never committed)
data/
!ml/data/

# artifacts: keep small starter weights + metrics, ignore full + checkpoints
artifacts/*/full/
artifacts/**/checkpoints/
artifacts/**/*.ckpt
artifacts/**/last.pt

# backend runtime
backend/storage/
backend/*.db
backend/*.db-journal
backend/*.db-wal
backend/*.db-shm

# frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/test-results/
frontend/playwright-report/
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# kaggle run outputs
ml/kaggle/*/output/
logs/
# trained weights ARE committed (via Git LFS, see .gitattributes); only training
# intermediates and smoke-test runs are ignored
artifacts/*/kaggle_smoke/
ml/kaggle/*_smoke/
