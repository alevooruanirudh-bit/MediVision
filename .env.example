# MediVision AI — environment variables. None of these are API keys for AI services.

# --- ML / training ---
PRETRAINED_BACKBONE=true          # true: generic ImageNet init (torchvision/timm). false: train from scratch
MEDIVISION_DATA_DIR=./data        # where datasets are downloaded / cached
MEDIVISION_ARTIFACTS_DIR=./artifacts  # trained weights, metrics JSON, plots
MEDIVISION_NO_MPS=0               # 1 = never use Apple MPS for training

# --- Backend ---
DATABASE_URL=sqlite:///./backend/medivision.db
STORAGE_DIR=./backend/storage     # uploaded (de-identified) images, overlays, PDFs
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:3000
MODEL_PROFILE=auto                # auto (prefer full, else starter) | starter | full
INFERENCE_BACKEND=onnx            # onnx | torch
MC_DROPOUT_SAMPLES=8
PSEUDONYM_SALT=change-me          # salt for pseudonymous patient IDs from DICOM
LOG_LEVEL=INFO

# --- Copilot ---
COPILOT_LOCAL_LLM=false           # optional localhost Ollama adapter; OFF by default
OLLAMA_URL=http://localhost:11434 # only localhost is accepted
OLLAMA_MODEL=llama3.2:3b

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Kaggle (optional, for full-profile GPU training) ---
# Put kaggle.json in ~/.kaggle/ instead of setting these.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
